{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "destination": "/store",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/store",
      "destination": "/index.html"
    },
    {
      "source": "/art-store",
      "destination": "/index.html"
    }
  ]
}

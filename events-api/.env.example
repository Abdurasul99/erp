# Настройки сервиса «Мероприятия» (events-api).
# Скопируйте в .env рядом с server.js и заполните. Сам .env в git не попадает.

# Тот же секрет, что в backend/.env Wave: токен выдаёт общий вход Wave, а этот
# сервис только проверяет подпись. Разные секреты = ни один вход не пройдёт.
JWT_SECRET=

# Своя база сервиса (создаётся sql/setup-prod.sql).
EVENTS_DB_NAME=events
EVENTS_DB_USER=events_app
EVENTS_DB_PASS=
EVENTS_DB_HOST=localhost
EVENTS_DB_PORT=5432

# Учётки: база warehouse под ролью с правами только на столбцы входа.
IDENTITY_DB_NAME=warehouse
IDENTITY_DB_USER=events_identity
IDENTITY_DB_PASS=
IDENTITY_DB_HOST=localhost
IDENTITY_DB_PORT=5432

# Только localhost — наружу сервис отдаёт nginx.
EVENTS_HOST=127.0.0.1
EVENTS_PORT=3002

# Настройки сервиса «Декор» (decor-api). На сервере .env создаёт deploy/install.sh
# со случайными паролем базы и секретом — вручную заполнять не нужно. Сам .env в git не попадает.

NODE_ENV=production
# «Сегодня» для брони и сроков считается по часам сервера
TZ=Asia/Tashkent

# Только localhost — наружу сервис отдаёт nginx (location /api/decor/)
DECOR_HOST=127.0.0.1
DECOR_PORT=3003

# Своя база сферы (создаёт install.sh, владелец — wave_decor_user)
DECOR_DB_HOST=127.0.0.1
DECOR_DB_PORT=5432
DECOR_DB_NAME=wave_decor
DECOR_DB_USER=wave_decor_user
DECOR_DB_PASS=

# СВОЙ секрет токенов, не тот, что у Wave: токен «Декора» не пройдёт в Wave и наоборот.
# Не короче 32 символов: openssl rand -hex 32
DECOR_JWT_SECRET=

# Фото и видео — доказательства по заказам. НЕ внутри backend/uploads и frontend/dist
# (их отдают без входа) — сервис с такой папкой не стартует. Папку — в ежедневный бэкап.
DECOR_UPLOADS_DIR=/var/lib/wave-decor/uploads
# Потолок одного файла, МБ (лимиты компании — в Настройках «Декора»)
# DECOR_UPLOAD_MAX_MB=500

# НИКОГДА на рабочем сервере (с NODE_ENV=production сервис не стартует):
# DECOR_TEST_HOOKS=1

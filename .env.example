# Backend env vars — copy this file to backend/.env and fill in real values.
# NEVER commit the actual backend/.env (it's in .gitignore).

# ========== PostgreSQL ==========
DB_NAME=warehouse
DB_USER=wareapp_user
DB_PASS=change_me
DB_HOST=localhost
DB_PORT=5432

# ========== JWT ==========
# Generate a strong random string ≥24 chars:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_random_32_byte_hex

# ========== DeepSeek AI consultant ==========
# Get a key at https://platform.deepseek.com → API Keys
# Without this key, /api/ai/chat returns HTTP 503 (AI features disabled,
# all other features keep working).
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ========== Runtime ==========
NODE_ENV=production
PORT=3001

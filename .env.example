# Backend env vars — copy this to backend/.env and fill in production values
# Never commit the actual .env file.

# PostgreSQL
DB_NAME=warehouse
DB_USER=wareapp_user
DB_PASS=change_me
DB_HOST=localhost

# JWT — generate a strong random string ≥24 chars:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_random_32_byte_hex

NODE_ENV=production
PORT=3000
